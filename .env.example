# Copy this file to ".env" and fill in ONE key. Never commit the real .env file.

# Which provider to use: anthropic | openai | gemini | grok
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# Optional: override the default model for the chosen provider
# (model names change over time - check your provider's docs if a call fails)
# LLM_MODEL=
